    "eslint-plugin-svelte": "^3.16.0",
    "globals": "^16.0.0",
    "prettier": "^3.0.0",
    "prettier-plugin-svelte": "^3.5.1",
    "svelte": "^5.55.0",
    "svelte-check": "^4.4.5",
    "tslib": "^2.8.0",
    "typescript": "^5.7.0",
    "vite": "^6.3.0"
  },
  "type": "module",
  "dependencies": {
    "@fontsource/fira-mono": "^5.2.7",
